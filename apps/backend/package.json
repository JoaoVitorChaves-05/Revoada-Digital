{
  "name": "backend",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "test": "vitest run --passWithNoTests=false",
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "prisma:migrate": "npx prisma migrate dev --create-only",
    "prisma:deploy": "npx prisma migrate deploy",
    "prisma:applied": "npx prisma migrate resolve --applied",
    "prisma:rolledback": "npx prisma migrate resolve --rolled-back"
  },
  "type": "commonjs",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "6.14.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "prisma": "6.14.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13",
    "vitest": "^5.0.0"
  }
}
