generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
// ------------------------------------------------------
// Enums para Tipagem Segura
// ------------------------------------------------------

enum ProfileType {
  STUDENT
  TEACHER
  ADMIN
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// ------------------------------------------------------
// Entidade Principal: Usuário
// ------------------------------------------------------

model User {
  id          String      @id @default(uuid())
  email       String      @unique
  full_name   String
  cpf         String      @unique
  profileType ProfileType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relacionamentos 1:1 com os perfis específicos (opcionais)
  studentProfile StudentProfile?
  teacherProfile TeacherProfile?
  adminProfile   AdminProfile?

  // Relacionamentos com as Solicitações de Aprovação:
  // 1. A solicitação referente ao cadastro deste usuário
  approvalRequest ApprovalRequest? @relation("UserRegistration")

  // 2. Solicitações que este usuário (se for Admin) aprovou/rejeitou
  approvedRequests ApprovalRequest[] @relation("AdminApprovals")

  @@map("users")
}

// ------------------------------------------------------
// Perfis de Usuário (1:1 com User)
// ------------------------------------------------------

model StudentProfile {
  id     String @id @default(uuid())
  points Int    @default(0) // Pontuação do Learn-to-Earn

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolname String
  school School @relation(fields: [schoolname], references: [name], onDelete: Restrict)

  @@map("student_profiles")
}

model TeacherProfile {
  id     String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolname String
  school School @relation(fields: [schoolname], references: [name], onDelete: Restrict)

  @@map("teacher_profiles")
}

model AdminProfile {
  id   String  @id @default(uuid())
  role String? @default("Geral")

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_profiles")
}

// ------------------------------------------------------
// Solicitação de Aprovação de Cadastro
// ------------------------------------------------------

model ApprovalRequest {
  id              String         @id @default(uuid())
  status          ApprovalStatus @default(PENDING)
  rejectionReason String?

  // Usuário que solicitou o cadastro
  userId String @unique
  user   User   @relation("UserRegistration", fields: [userId], references: [id], onDelete: Cascade)

  // Administrador que realizou a aprovação/rejeição (opcional até ser avaliado)
  approvedById String?
  approvedBy   User?   @relation("AdminApprovals", fields: [approvedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("approval_requests")
}

model School{
  id   String @id @default(uuid())
  name String @unique
  city String

  // Listas de relações inversas necessárias para o Prisma
  students StudentProfile[]
  teachers TeacherProfile[]

  @@map("schools")
}

model MockExam{
  id        String   @id @default(uuid())
  name      String
  studentId String @unique
  student  StudentProfile @relation(fields: [studentId], references: [id], onDelete: Restrict)
  #attempts Attempt[]

  @@map("mock_exams")
}
