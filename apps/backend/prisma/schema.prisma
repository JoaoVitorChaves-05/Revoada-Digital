generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  full_name        String
  rg               String            @unique
  cpf              String            @unique
  profileType      ProfileType
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  adminProfile     AdminProfile?
  approvedRequests ApprovalRequest[] @relation("AdminApprovals")
  approvalRequest  ApprovalRequest?  @relation("UserRegistration")
  studentProfile   StudentProfile?
  teacherProfile   TeacherProfile?

  @@map("users")
}

model StudentProfile {
  id     String @id @default(uuid())
  school String
  points Int    @default(0)
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

model TeacherProfile {
  id     String @id @default(uuid())
  school String
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("teacher_profiles")
}

model AdminProfile {
  id     String  @id @default(uuid())
  role   String? @default("Geral")
  userId String  @unique
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_profiles")
}

model ApprovalRequest {
  id              String         @id @default(uuid())
  status          ApprovalStatus @default(PENDING)
  rejectionReason String?
  userId          String         @unique
  approvedById    String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  approvedBy      User?          @relation("AdminApprovals", fields: [approvedById], references: [id])
  user            User           @relation("UserRegistration", fields: [userId], references: [id], onDelete: Cascade)

  @@map("approval_requests")
}

enum ProfileType {
  STUDENT
  TEACHER
  ADMIN
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}
