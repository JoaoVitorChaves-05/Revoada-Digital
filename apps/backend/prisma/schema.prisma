generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
// ------------------------------------------------------
// Enums para Tipagem Segura
// ------------------------------------------------------

enum ProfileType {
  STUDENT
  TEACHER
  ADMIN
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// ------------------------------------------------------
// Entidade Principal: Usuário
// ------------------------------------------------------

model User {
  id          String      @id @default(uuid())
  email       String      @unique
  full_name   String
  cpf         String      @unique
  profileType ProfileType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relacionamentos 1:1 com os perfis específicos (opcionais)
  studentProfile StudentProfile?
  teacherProfile TeacherProfile?
  adminProfile   AdminProfile?

  // Relacionamentos com as Solicitações de Aprovação:
  // 1. A solicitação referente ao cadastro deste usuário
  approvalRequest ApprovalRequest? @relation("UserRegistration")

  // 2. Solicitações que este usuário (se for Admin) aprovou/rejeitou
  approvedRequests ApprovalRequest[] @relation("AdminApprovals")
  approvalRequest  ApprovalRequest?  @relation("UserRegistration")
  studentProfile   StudentProfile?
  teacherProfile   TeacherProfile?

  @@map("users")
}

model StudentProfile {
  id     String @id @default(uuid())
  points Int    @default(0) // Pontuação do Learn-to-Earn

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId String
  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  mockExams MockExam[]

  @@map("student_profiles")
}

model TeacherProfile {
  id     String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId String
  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@map("teacher_profiles")
}

model AdminProfile {
  id     String  @id @default(uuid())
  role   String? @default("Geral")
  userId String  @unique
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_profiles")
}

model ApprovalRequest {
  id              String         @id @default(uuid())
  status          ApprovalStatus @default(PENDING)
  rejectionReason String?
  userId          String         @unique
  approvedById    String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  approvedBy      User?          @relation("AdminApprovals", fields: [approvedById], references: [id])
  user            User           @relation("UserRegistration", fields: [userId], references: [id], onDelete: Cascade)

  @@map("approval_requests")
}

model School{
  id   String @id @default(uuid())
  school_name String @unique
  school_city String

  // Listas de relações inversas necessárias para o Prisma
  students StudentProfile[]
  teachers TeacherProfile[]

  @@map("schools")
}

model MockExam {
  id        String   @id @default(uuid())
  name      String
  studentId String

  student   StudentProfile     @relation(fields: [studentId], references: [id], onDelete: Restrict)
  questions MockExamQuestion[]
  attempts  Attempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@map("mock_exams")
}

model MockExamQuestion {
  mockExamId String
  questionId String
  position   Int

  mockExam MockExam @relation(fields: [mockExamId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@id([mockExamId, questionId])
  @@unique([mockExamId, position])
  @@map("mock_exam_questions")
}

model Question {
  id         String @id @default(uuid())
  text       String @unique
  difficulty Int

  mockExams    MockExamQuestion[]
  answers      AttemptAnswer[]
  alternatives Alternative[]

  @@map("questions")
}


enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  ABANDONED
}

model Attempt {
  id              String        @id @default(uuid())
  mockExamId      String
  status          AttemptStatus @default(IN_PROGRESS)
  startedAt       DateTime      @default(now())
  submittedAt     DateTime?
  score           Int?
  correctAnswers  Int?
  totalQuestions  Int?
  earnedPoints    Int?

  mockExam MockExam        @relation(fields: [mockExamId], references: [id], onDelete: Cascade)
  answers  AttemptAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mockExamId])
  @@map("attempts")
}

model AttemptAnswer {
  id                   String   @id @default(uuid())
  attemptId            String
  questionId           String
  selectedAlternativeId String?
  isCorrect            Boolean?
  answeredAt           DateTime?

  attempt             Attempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question            Question    @relation(fields: [questionId], references: [id], onDelete: Restrict)
  selectedAlternative  Alternative? @relation(fields: [selectedAlternativeId], references: [id], onDelete: Restrict)

  @@unique([attemptId, questionId])
  @@index([questionId])
  @@map("attempt_answers")
}

model Alternative {
  id         String  @id @default(uuid())
  text       String
  isCorrect  Boolean
  questionId String

  question Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  AttemptAnswer[]

  @@map("alternatives")
}