generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------
// Enums para Tipagem Segura
// ------------------------------------------------------

enum ProfileType {
  STUDENT
  TEACHER
  ADMIN
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Subjects {
  PORTUGUESE
  MATH
  ENGLISH
  GEOGRAPHY
  PHYSICS
  CHEMICAL
  HISTORY
}

// ------------------------------------------------------
// Entidade Principal: Usuário
// ------------------------------------------------------

model User {
  id          String      @id @default(uuid())
  email       String      @unique
  password    String
  full_name   String
  cpf         String      @unique
  profileType ProfileType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relacionamentos 1:1 com os perfis específicos (opcionais)
  studentProfile StudentProfile?
  teacherProfile TeacherProfile?
  adminProfile   AdminProfile?

  // Relacionamentos com as Solicitações de Aprovação:
  // 1. A solicitação referente ao cadastro deste usuário
  approvalRequest ApprovalRequest? @relation("UserRegistration")

  // 2. Solicitações que este usuário (se for Admin) aprovou/rejeitou
  approvedRequests ApprovalRequest[] @relation("AdminApprovals")

  forumPosts   Forum[]        @relation("ForumAuthor")
  forumReplies ForumReplies[] @relation("ForumReplyAuthor")

  // Relacionamentos do chat
  chatParticipants ConversationParticipant[]
  sentMessages     ChatMessage[] @relation("ChatMessageSender")
  messageReads     MessageRead[]

  @@map("users")
}

model StudentProfile {
  id     String @id @default(uuid())
  points Int    @default(0) // Pontuação do Learn-to-Earn

  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId  String
  school    School     @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  mockExams MockExam[]

  @@map("student_profiles")
}

model TeacherProfile {
  id String @id @default(uuid())

  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@map("teacher_profiles")
}

model AdminProfile {
  id     String  @id @default(uuid())
  role   String? @default("Geral")
  userId String  @unique
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_profiles")
}

model ApprovalRequest {
  id              String         @id @default(uuid())
  status          ApprovalStatus @default(PENDING)
  rejectionReason String?
  userId          String         @unique
  approvedById    String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  approvedBy      User?          @relation("AdminApprovals", fields: [approvedById], references: [id])
  user            User           @relation("UserRegistration", fields: [userId], references: [id], onDelete: Cascade)

  @@map("approval_requests")
}

model School{
  id   String @id @default(uuid())
  school_name String @unique
  school_city String

  // Listas de relações inversas necessárias para o Prisma
  students StudentProfile[]
  teachers TeacherProfile[]

  @@map("schools")
}

model MockExam {
  id        String   @id @default(uuid())
  name      String
  studentId String

  student   StudentProfile     @relation(fields: [studentId], references: [id], onDelete: Restrict)
  questions MockExamQuestion[]
  attempts  Attempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@map("mock_exams")
}

model MockExamQuestion {
  mockExamId String
  questionId String
  position   Int

  mockExam MockExam @relation(fields: [mockExamId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@id([mockExamId, questionId])
  @@unique([mockExamId, position])
  @@map("mock_exam_questions")
}

model Question {
  id         String @id @default(uuid())
  text       String @unique
  difficulty Int
  image   String?

  mockExams    MockExamQuestion[]
  answers      AttemptAnswer[]
  alternatives Alternative[]

  @@map("questions")
}


enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  ABANDONED
}

model Attempt {
  id              String        @id @default(uuid())
  mockExamId      String
  status          AttemptStatus @default(IN_PROGRESS)
  startedAt       DateTime      @default(now())
  submittedAt     DateTime?
  score           Int?
  correctAnswers  Int?
  totalQuestions  Int?
  earnedPoints    Int?

  mockExam MockExam        @relation(fields: [mockExamId], references: [id], onDelete: Cascade)
  answers  AttemptAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mockExamId])
  @@map("attempts")
}

model AttemptAnswer {
  id                   String   @id @default(uuid())
  attemptId            String
  questionId           String
  selectedAlternativeId String?
  isCorrect            Boolean?
  answeredAt           DateTime?

  attempt             Attempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question            Question    @relation(fields: [questionId], references: [id], onDelete: Restrict)
  selectedAlternative  Alternative? @relation(fields: [selectedAlternativeId], references: [id], onDelete: Restrict)

  @@unique([attemptId, questionId])
  @@index([questionId])
  @@map("attempt_answers")
}

model Alternative {
  id         String  @id @default(uuid())
  text       String
  isCorrect  Boolean
  questionId String

  question Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  AttemptAnswer[]

  @@map("alternatives")
}

model Forum {
  id        String         @id @default(uuid())
  authorId  String
  title     String
  content   String
  subject   Subjects
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  author  User          @relation("ForumAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  replies ForumReplies[]

  @@index([authorId])
  @@index([subject])
  @@map("forums")
}

model ForumReplies {
  id           String   @id @default(uuid())
  forumId      String
  authorId     String
  replyContent String

  forum  Forum @relation(fields: [forumId], references: [id], onDelete: Cascade)
  author User  @relation("ForumReplyAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([forumId])
  @@index([authorId])
  @@map("forum_replies")
}

enum ConversationType {
  DIRECT
  GROUP
}

model Conversation {
  id        String           @id @default(uuid())
  type      ConversationType
  name      String?
  createdAt DateTime         @default(now()) @map("created_at")

  participants ConversationParticipant[]
  messages     ChatMessage[]

  @@map("chat_conversations")
}

model ConversationParticipant {
  conversationId String   @map("conversation_id")
  userId         String   @map("user_id")
  joinedAt       DateTime @default(now()) @map("joined_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("chat_conversation_participants")
}

model ChatMessage {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  senderId       String   @map("sender_id")
  content        String
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  sender       User         @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  reads        MessageRead[]

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("chat_messages")
}

model MessageRead {
  messageId String   @map("message_id")
  userId    String   @map("user_id")
  readAt    DateTime @default(now()) @map("read_at")

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Restrict)
  user    User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([messageId, userId])
  @@index([userId])
  @@map("chat_message_reads")
}