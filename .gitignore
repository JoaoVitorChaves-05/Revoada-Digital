# ==========================================
# 📦 Node.js & Monorepo (Geral)
# ==========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/

# ==========================================
# 🔐 Variáveis de Ambiente
# ==========================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# Permite commitar os arquivos de exemplo para a equipe
!.env.example
!.env.sample

# ==========================================
# 🖥️ Logs, Sistema e IDEs
# ==========================================
logs/
*.log
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# ==========================================
# ⚛️ Frontend (Vite + React)
# ==========================================
# Pastas de output/build do Vite
dist/
dist-ssr/
# Cache de ferramentas
.eslintcache
node_modules/.vite/
# Relatórios de testes (Vitest/Jest)
coverage/

# ==========================================
# ⚙️ Backend (TypeScript)
# ==========================================
# Pastas de build do compilador TS (tsc)
build/
out/
lib/
# Cache incremental do TypeScript
*.tsbuildinfo

# ==========================================
# 🗄️ Prisma ORM
# ==========================================
# Ignorar bancos de dados locais (SQLite)
*.db
*.db-journal
*.sqlite

# (Opcional) Caso você configure o Prisma Client para ser 
# gerado em uma pasta customizada em vez do node_modules
# prisma/generated/
apps/backend/src/generated/