# Exemplo de variaveis para o container do backend (.env.docker).
# Copie para .env.docker e ajuste conforme necessario.
# NUNCA comite o .env.docker real nem segredos.

# Banco local do compose (servico "db"). Valores batem com o compose.yml.
DATABASE_URL="postgresql://dev:Revoada@db:5432/DevRevoada_Digital?schema=public"
DIRECT_URL="postgresql://dev:Revoada@db:5432/DevRevoada_Digital?schema=public"

# Porta do backend dentro do container.
PORT=3000

# URL do frontend (usada em links de email, CORS, etc.).
FRONTEND_URL="http://localhost:5173"

# Envio de email (Resend). Em dev pode deixar vazio: ha fallback de log.
RESEND_API_KEY=""
EMAIL_FROM="Revoada Digital <no-reply@example.com>"